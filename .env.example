# ============================================================
# CampusPulse — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Supabase (get from: https://supabase.com/dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini AI (get from: https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Brevo Email (get from: https://app.brevo.com → SMTP & API → API Keys)
VITE_BREVO_API_KEY=your-brevo-api-key-here

# Sender email (must be verified in Brevo)
VITE_SENDER_EMAIL=noreply@campuspulse.app

# App URL (your deployed URL — used for QR codes and email links)
VITE_APP_URL=http://localhost:5173
